    training_analysis_df
    .corr(numeric_only=True)[["quality_class"]]
    .drop(index="quality_class")
    .sort_values(
        by="quality_class",
        ascending=False
    )
)

target_correlations


plt.figure(figsize=(7, 8))

sns.heatmap(
