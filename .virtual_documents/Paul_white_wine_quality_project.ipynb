


import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

wine_df = pd.read_csv("winequality-white.csv", sep=";")

wine_df.head()


print("Number of rows:", wine_df.shape[0])
print("Number of columns:", wine_df.shape[1])

wine_df.info()





print("Number of duplicated rows:", wine_df.duplicated().sum())





wine_df = wine_df.drop_duplicates().reset_index(drop=True)

print("Number of rows after removing duplicates:", wine_df.shape[0])
print("Remaining duplicated rows:", wine_df.duplicated().sum())






wine_df.describe().T





plt.figure(figsize=(8, 5))

sns.countplot(
    data=wine_df,
    x="quality",
    color="steelblue"
)

plt.title("Distribution of White Wine Quality Scores")
plt.xlabel("Quality Score")
plt.ylabel("Number of Wines")
plt.tight_layout()
plt.show()








quality_correlations = (
    wine_df.corr(numeric_only=True)["quality"]
    .sort_values(ascending=False)
)

quality_correlations





feature_correlations = quality_correlations.drop("quality")

plt.figure(figsize=(9, 6))

sns.barplot(
    x=feature_correlations.values,
    y=feature_correlations.index,
    color="steelblue"
)

plt.axvline(0, color="black", linewidth=1)
plt.title("Correlation of Physicochemical Features with Wine Quality")
plt.xlabel("Correlation with Quality")
plt.ylabel("Feature")
plt.tight_layout()
plt.show()











X = wine_df.drop(columns="quality")
y = wine_df["quality"]

print("Features shape:", X.shape)
print("Target shape:", y.shape)





from sklearn.model_selection import train_test_split

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42
)

print("Training features:", X_train.shape)
print("Testing features:", X_test.shape)
print("Training targets:", y_train.shape)
print("Testing targets:", y_test.shape)



